{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["ready", "insufficient_evidence"] },
    "overview": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "claims": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "assessment": { "type": "string", "enum": ["supported", "mixed", "uncertain"] },
          "evidenceAliases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^evidence_[0-9]{3}$" }
          }
        },
        "required": ["text", "assessment", "evidenceAliases"],
        "additionalProperties": false
      }
    },
    "deltas": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["new", "updated", "contradicted", "resolved"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidenceAliases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^evidence_[0-9]{3}$" }
          }
        },
        "required": ["kind", "text", "evidenceAliases"],
        "additionalProperties": false
      }
    }
  },
  "required": ["status", "overview", "claims", "deltas"],
  "additionalProperties": false
}

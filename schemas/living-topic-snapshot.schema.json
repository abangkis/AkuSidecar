{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["ready", "insufficient_evidence"] },
    "overview": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "claims": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 120 },
          "materialValue": { "type": "string", "minLength": 1, "maxLength": 500 },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "assessment": { "type": "string", "enum": ["supported", "mixed", "uncertain", "unavailable"] },
          "centrality": { "type": "string", "enum": ["central", "secondary"] },
          "subtopic": { "type": "string", "minLength": 1, "maxLength": 120 },
          "temporalStatus": { "type": "string", "enum": ["current", "historical", "unknown"] },
          "eventStatus": { "type": "string", "enum": ["announced", "ongoing", "completed", "cancelled", "unknown"] },
          "evidenceAliases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^evidence_[0-9]{3}$" }
          }
        },
        "required": ["key", "materialValue", "text", "assessment", "centrality", "subtopic", "temporalStatus", "eventStatus", "evidenceAliases"],
        "additionalProperties": false
      }
    },
    "deltas": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["new", "updated", "contradicted", "removed"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidenceAliases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^evidence_[0-9]{3}$" }
          }
        },
        "required": ["kind", "text", "evidenceAliases"],
        "additionalProperties": false
      }
    },
    "evidenceRoles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "evidenceAlias": { "type": "string", "pattern": "^evidence_[0-9]{3}$" },
          "role": { "type": "string", "enum": ["core", "supporting", "peripheral", "undetermined"] },
          "subtopic": { "type": "string", "minLength": 1, "maxLength": 120 },
          "sourceCluster": { "type": "string", "minLength": 1, "maxLength": 120 },
          "epistemicClass": { "type": "string", "enum": ["primary", "attributed_secondary", "unattributed", "speculative"] }
        },
        "required": ["evidenceAlias", "role", "subtopic", "sourceCluster", "epistemicClass"],
        "additionalProperties": false
      }
    },
    "coverageState": { "type": "string", "enum": ["focused", "partial", "sparse"] }
  },
  "required": ["status", "overview", "claims", "deltas", "evidenceRoles", "coverageState"],
  "additionalProperties": false
}

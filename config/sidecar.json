{
  "version": 1,
  "deployment": {
    "mode": "development",
    "runtimeInstallKind": "workspace",
    "bridgeIdentityProfile": "development"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 11122
  },
  "database": {
    "path": "runtime/aku-sidecar.db"
  },
  "reasoning": {
    "activeProvider": "codex-app-server",
    "providers": {
      "codex-app-server": {
        "executable": "",
        "maxRetries": 0,
        "timeoutMs": 120000,
        "planning": {
          "model": "gpt-5.6-luna",
          "effort": "high"
        },
        "evaluation": {
          "model": "gpt-5.6-luna",
          "effort": "high"
        },
        "semanticEvent": {
          "model": "gpt-5.6-luna",
          "effort": "high"
        },
        "aiDetection": {
          "model": "gpt-5.6-luna",
          "effort": "high"
        }
      },
      "ollama": {
        "endpoint": "http://127.0.0.1:11434",
        "maxRetries": 1,
        "timeoutMs": 300000,
        "planning": {
          "model": "nemotron-3.5-lightning:latest",
          "effort": "high"
        },
        "evaluation": {
          "model": "nemotron-3.5-lightning:latest",
          "effort": "high"
        },
        "semanticEvent": {
          "model": "nemotron-3.5-lightning:latest",
          "effort": "high"
        },
        "aiDetection": {
          "model": "nemotron-3.5-lightning:latest",
          "effort": "high"
        }
      }
    }
  },
  "capture": {
    "profile": "standard",
    "visibility": "quiet",
    "openMissingSource": true,
    "maxAcquisitionRounds": 2
  },
  "bridge": {
    "trustedExtensionOrigins": []
  },
  "preference": {
    "mode": "guarded_live"
  }
}

{
 "manifest_version": 3,
 "name": "AkuBrowser UI Reader Broker",
 "version": "1.0.1",
 "description": "Explicit native-post activation for the isolated Windows AkuBrowser UI.",
 "key": "",
 "permissions": ["nativeMessaging"],
 "host_permissions": ["http://127.0.0.1:11122/*", "http://localhost:11122/*"],
 "background": {"service_worker": "service-worker.js"},
 "content_scripts": [{"matches": ["http://127.0.0.1:11122/*", "http://localhost:11122/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]
}
